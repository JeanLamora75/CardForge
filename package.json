{
  "name": "cardforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run assets:optimize && vite",
    "build": "npm run assets:optimize && tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "verify:pwa": "node scripts/verify-pwa-build.mjs",
    "audit:rules": "node scripts/audit-rule-coverage.mjs --require-complete",
    "test:browser": "node scripts/test-indexeddb-browser.mjs",
    "test:e2e:production": "node scripts/test-production-e2e.mjs",
    "audit:publication": "node scripts/audit-publication-gate.mjs",
    "release:check": "node scripts/audit-publication-gate.mjs --require-mvp-publication",
    "prepublishOnly": "npm run release:check",
    "assets:optimize": "node scripts/optimize-art.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.7.3",
    "vite": "^6.0.0",
    "fake-indexeddb": "^6.2.0",
    "playwright": "^1.56.0",
    "sharp": "^0.34.5",
    "@types/node": "^22.0.0"
  }
}
